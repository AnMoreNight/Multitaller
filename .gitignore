# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vercel
.vinxi
.tanstack/**
.nitro
*.local
*.tsbuildinfo

# Local env vars (DATABASE_URL etc.) — *.local above already covers .env.local
.env
.env.*
!.env.example

# This project uses npm (package-lock.json, committed) — ignore other package
# managers' lockfiles so an accidental `yarn`/`pnpm`/`bun install` doesn't
# produce a second, conflicting lockfile that gets committed by mistake.
yarn.lock
pnpm-lock.yaml
bun.lock
bun.lockb

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.history/
*.sw?
*~

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
